{
  "manifest_version": 3,
  "name": "השוואת עגלות סופר",
  "version": "2.3",
  "description": "תוסף שמשווה את עגלת הקניות שלך מול רשתות מתחרות",
  "action": {
    "default_title": "פתח השוואת עגלות"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.rami-levy.co.il/*",
    "*://*.victoryonline.co.il/*",
    "*://*.victory.co.il/*",
    "*://*.shufersal.co.il/*",
    "*://*.mck.co.il/*",
    "*://*.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://*.supabase.co https://nominatim.openstreetmap.org https://*.rami-levy.co.il https://*.shufersal.co.il https://*.victoryonline.co.il https://*.victory.co.il https://*.mck.co.il"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.rami-levy.co.il/*"
      ],
      "js": [
        "rami_guest.js",
        "rami_levy_injector.js"
      ]
    },
    {
      "matches": [
        "*://*.victoryonline.co.il/*",
        "*://*.victory.co.il/*"
      ],
      "js": [
        "victory_injector.js"
      ]
    },
    {
      "matches": [
        "*://*.mck.co.il/*"
      ],
      "js": [
        "shuk_injector.js"
      ]
    },
    {
      "matches": [
        "*://*.shufersal.co.il/*"
      ],
      "js": [
        "shufersal_injector.js"
      ]
    },
    {
      "matches": [
        "*://*.shufersal.co.il/*"
      ],
      "js": [
        "shufersal_main_helper.js"
      ],
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
